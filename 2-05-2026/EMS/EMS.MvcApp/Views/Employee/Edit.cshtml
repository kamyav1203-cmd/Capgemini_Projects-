@model Employee
@{ ViewData["Title"] = "Edit Employee"; }

<div class="form-page">
    <div class="form-header">
        <a href="/Employee" class="back-link">← Back</a>
        <h1 class="page-title">Edit Employee <span class="id-badge">#@Model.Id</span></h1>
    </div>

    <div class="form-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div class="form-group">
                <label asp-for="Name">Full Name</label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Department">Department</label>
                <input asp-for="Department" class="form-input" />
                <span asp-validation-for="Department" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" type="email" class="form-input" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Salary">Salary (₹)</label>
                <input asp-for="Salary" type="number" class="form-input" />
                <span asp-validation-for="Salary" class="field-error"></span>
            </div>

            <div class="form-actions">
                <a href="/Employee" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
