@model Employee
@{ ViewData["Title"] = "Delete Employee"; }

<div class="form-page">
    <div class="form-header">
        <a href="/Employee" class="back-link">← Back</a>
        <h1 class="page-title danger-title">Delete Employee</h1>
    </div>

    <div class="form-card delete-card">
        <div class="delete-warning">
            <span class="warning-icon">⚠</span>
            <p>Are you sure you want to permanently delete this employee?</p>
        </div>

        <div class="detail-row">
            <span class="detail-label">Name</span>
            <span class="detail-value">@Model.Name</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Department</span>
            <span class="detail-value">@Model.Department</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value">@Model.Email</span>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="form-actions">
                <a href="/Employee" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
            </div>
        </form>
    </div>
</div>
