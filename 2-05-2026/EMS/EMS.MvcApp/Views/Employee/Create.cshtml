@model Employee
@{ ViewData["Title"] = "New Employee"; }

<div class="form-page">
    <div class="form-header">
        <a href="/Employee" class="back-link">← Back</a>
        <h1 class="page-title">New Employee</h1>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Name">Full Name</label>
                <input asp-for="Name" class="form-input" placeholder="e.g. Priya Sharma" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Department">Department</label>
                <input asp-for="Department" class="form-input" placeholder="e.g. Engineering" />
                <span asp-validation-for="Department" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" type="email" class="form-input" placeholder="e.g. priya@company.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Salary">Salary (₹)</label>
                <input asp-for="Salary" type="number" class="form-input" placeholder="e.g. 850000" />
                <span asp-validation-for="Salary" class="field-error"></span>
            </div>

            <div class="form-actions">
                <a href="/Employee" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Employee</button>
            </div>
        </form>
    </div>
</div>
