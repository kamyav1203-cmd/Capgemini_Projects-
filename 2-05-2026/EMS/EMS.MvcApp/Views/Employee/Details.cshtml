@model Employee
@{ ViewData["Title"] = "Employee Details"; }

<div class="form-page">
    <div class="form-header">
        <a href="/Employee" class="back-link">← Back</a>
        <h1 class="page-title">Employee <span class="id-badge">#@Model.Id</span></h1>
    </div>

    <div class="form-card detail-card">
        <div class="detail-row">
            <span class="detail-label">Name</span>
            <span class="detail-value">@Model.Name</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Department</span>
            <span class="detail-value"><span class="dept-badge">@Model.Department</span></span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value">@Model.Email</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Salary</span>
            <span class="detail-value salary-big">₹@Model.Salary.ToString("N0")</span>
        </div>

        <div class="form-actions">
            <a href="/Employee/Edit/@Model.Id" class="btn btn-primary">Edit</a>
            <a href="/Employee/Delete/@Model.Id" class="btn btn-danger">Delete</a>
        </div>
    </div>
</div>
